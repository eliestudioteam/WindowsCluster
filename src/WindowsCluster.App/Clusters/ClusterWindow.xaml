<Window x:Class="WindowsCluster.App.Clusters.ClusterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsCluster.App.Clusters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ClusterViewModel}"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        MinWidth="160" MinHeight="90"
        Width="360" Height="240"
        FontFamily="{StaticResource Font.Text}">

    <!-- WindowChrome supplies the native resize borders on a borderless window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Background layer: only this fades with the Cluster's transparency setting. -->
        <Border CornerRadius="8"
                Background="{DynamicResource Brush.ClusterBackground}"
                BorderBrush="{DynamicResource Brush.ClusterBorder}"
                BorderThickness="1"
                Opacity="{Binding Opacity}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Header"
                    Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    Background="{DynamicResource Brush.ClusterHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource Brush.ClusterText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Padding="4,1"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       x:Name="EmptyHint"
                       Text="Este Cluster está vacío"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ClusterItemViewModel}">
                            <Border x:Name="ItemBorder"
                                    Width="84"
                                    Margin="2"
                                    Padding="4,6"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    ToolTip="{Binding DisplayName}"
                                    MouseLeftButtonDown="Item_MouseLeftButtonDown">
                                <StackPanel>
                                    <!-- 256 px source scaled down with high-quality filtering: sharp at any DPI. -->
                                    <Image Source="{Binding Icon}"
                                           Width="48" Height="48"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.ClusterText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="32" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.ClusterItemHover}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
