<Window x:Class="WindowsCluster.App.Clusters.ClusterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsCluster.App.Clusters"
        xmlns:desktop="clr-namespace:WindowsCluster.App.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ClusterViewModel}"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        MinWidth="160" MinHeight="90"
        Width="360" Height="240"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Explorer's desktop item states (Windows 11). -->
        <SolidColorBrush x:Key="Item.HoverFill" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="Item.HoverBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Item.SelectedFill" Color="#4D99CCFF" />
        <SolidColorBrush x:Key="Item.SelectedBorder" Color="#8099CCFF" />
        <SolidColorBrush x:Key="Item.SelectedHoverFill" Color="#6699CCFF" />
        <SolidColorBrush x:Key="Band.Fill" Color="#4D3399FF" />
        <SolidColorBrush x:Key="Band.Border" Color="#CC3399FF" />

        <!-- Explorer's in-place rename box: white, black text, thin border, blue selection. -->
        <Style x:Key="RenameBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="CaretBrush" Value="Black" />
            <Setter Property="SelectionBrush" Value="#0078D7" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="BorderBrush" Value="#FF7A7A7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- WindowChrome supplies the native resize borders on a borderless window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Background layer: only this fades with the Cluster's transparency setting. -->
        <Border CornerRadius="8"
                Background="{Binding BackgroundBrush}"
                Opacity="{Binding BackgroundOpacity}" />
        <Border CornerRadius="8"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="1" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Header"
                    Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    Background="{Binding HeaderBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp"
                    LostMouseCapture="Header_LostMouseCapture">
                <Grid Margin="10,0">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               Foreground="{Binding TextBrush}"
                               Effect="{Binding LabelEffect}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Padding="4,1"
                             KeyDown="TitleEditor_KeyDown"
                             LostKeyboardFocus="TitleEditor_LostKeyboardFocus" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       x:Name="EmptyHint"
                       Text="Arrastra archivos aquí"
                       Foreground="{Binding TextBrush}"
                       Effect="{Binding LabelEffect}"
                       Opacity="0.7"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <Grid Grid.Row="1" x:Name="Body"
                  Background="Transparent"
                  MouseLeftButtonDown="Body_MouseLeftButtonDown"
                  MouseMove="Body_MouseMove"
                  MouseLeftButtonUp="Body_MouseLeftButtonUp"
                  MouseRightButtonUp="Body_MouseRightButtonUp">
                <ScrollViewer x:Name="Scroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4">
                    <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ClusterItemViewModel}">
                                <Border x:Name="ItemBorder"
                                        Width="{Binding ItemWidth, Source={x:Static desktop:DesktopViewState.Current}}"
                                        Margin="1"
                                        Padding="2,4,2,4"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        ToolTip="{Binding InfoTip}"
                                        ToolTipService.InitialShowDelay="600"
                                        MouseLeftButtonDown="Item_MouseLeftButtonDown"
                                        MouseMove="Item_MouseMove"
                                        MouseRightButtonUp="Item_MouseRightButtonUp">
                                    <StackPanel>
                                        <!-- Requested at the exact displayed pixel size: Explorer's own artwork. -->
                                        <Image Source="{Binding Icon}"
                                               Width="{Binding IconSize, Source={x:Static desktop:DesktopViewState.Current}}"
                                               Height="{Binding IconSize, Source={x:Static desktop:DesktopViewState.Current}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True"
                                               UseLayoutRounding="True" />
                                        <Grid Margin="0,3,0,0">
                                            <TextBlock x:Name="Label"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Effect="{Binding DataContext.LabelEffect, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="32"
                                                       MouseLeftButtonUp="Label_MouseLeftButtonUp" />
                                            <TextBox Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                     Style="{StaticResource RenameBox}"
                                                     Text="{Binding DisplayName, Mode=OneWay}"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                     KeyDown="RenameBox_KeyDown"
                                                     LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Item.HoverFill}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Item.HoverBorder}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Item.SelectedFill}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Item.SelectedBorder}" />
                                        <!-- Selected items show their full name, like Explorer. -->
                                        <Setter TargetName="Label" Property="MaxHeight" Value="1000" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter TargetName="Label" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, ElementName=ItemBorder}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Item.SelectedHoverFill}" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Left-button rubber band, drawn like Explorer's. -->
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="Band"
                               Visibility="Collapsed"
                               Fill="{StaticResource Band.Fill}"
                               Stroke="{StaticResource Band.Border}"
                               StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Grid>

        <!-- Drop target highlight. -->
        <Border x:Name="DropHighlight"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{DynamicResource Brush.Accent}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
    </Grid>
</Window>
