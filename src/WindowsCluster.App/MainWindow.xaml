<Window x:Class="WindowsCluster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Cluster — Diagnóstico de escritorio"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Style.Window}">
    <!-- Temporary test bench for the DesktopHost module; the full Manager UI comes later. -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="DesktopHost" />

        <TextBox x:Name="TopologyText"
                 DockPanel.Dock="Top"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Capa:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="DesktopLayerOption" Content="Escritorio" IsChecked="True" GroupName="Layer" />
            <RadioButton Content="Fondo / WorkerW" Margin="6,0,0,0" GroupName="Layer" />
            <Button Content="Crear Cluster de prueba" Margin="12,0,0,0" Padding="12,4" Click="CreateCluster_Click" />
            <Button Content="Refrescar" Margin="8,0,0,0" Padding="12,4" Click="Refresh_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,16,0,4" Text="Clusters activos. Arrastra con clic derecho sobre el escritorio para crear uno." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Mover a la otra capa" Padding="12,4" Click="ToggleMode_Click" />
            <Button Content="Eliminar" Margin="8,0,0,0" Padding="12,4" Click="Remove_Click" />
        </StackPanel>
        <ListBox x:Name="ClusterList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="180" />
                        <TextBlock Text="{Binding Mode}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
