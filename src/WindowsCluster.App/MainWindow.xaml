<Window x:Class="WindowsCluster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:manager="clr-namespace:WindowsCluster.App.Manager"
        Title="Windows Cluster"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Style.Window}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Brush.NavBackground}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,18">
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.Accent}">
                    <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Windows Cluster" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <RadioButton DockPanel.Dock="Bottom" x:Name="NavAbout" Style="{StaticResource Style.NavButton}"
                         GroupName="Nav" Tag="&#xE946;" Content="Acerca de" Margin="8,0,8,12"
                         Checked="Nav_Checked" />

            <StackPanel Margin="8,0">
                <RadioButton x:Name="NavHome" Style="{StaticResource Style.NavButton}" GroupName="Nav"
                             Tag="&#xE80F;" Content="Inicio" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavClusters" Style="{StaticResource Style.NavButton}" GroupName="Nav"
                             Tag="&#xF0E2;" Content="Mis Clusters" Checked="Nav_Checked" />
            </StackPanel>
        </DockPanel>

        <!-- Page content -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.PageBackground}"
                BorderBrush="{DynamicResource Brush.SurfaceBorder}" BorderThickness="1,0,0,0">
            <ContentControl x:Name="PageHost" Margin="32,24,32,24" />
        </Border>
    </Grid>
</Window>
