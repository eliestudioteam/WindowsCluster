<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 dark palette. Accent-derived brushes are set at runtime by ThemeService. -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Brush.SurfaceBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlFill" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlFillHover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="Brush.HoverFill" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.PressedFill" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5DFFFFFF" />

    <SolidColorBrush x:Key="Brush.ClusterBackground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Brush.ClusterHeader" Color="#33000000" />
    <SolidColorBrush x:Key="Brush.ClusterBorder" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="Brush.ClusterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ClusterItemHover" Color="#20FFFFFF" />

    <Color x:Key="Color.Shadow">#80000000</Color>
</ResourceDictionary>
