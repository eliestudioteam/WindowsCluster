<Window x:Class="WindowsCluster.App.Views.ModernShellMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Cluster shell menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Font.Text}"
        FontSize="14">
    <!-- Windows 11 layout: action row on top, commands below, "Show more options" last.
         Every command is the shell's own, read from IContextMenu by ShellContextMenu.Session. -->
    <Border Margin="12"
            MinWidth="300"
            CornerRadius="8"
            Padding="4"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.SurfaceBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="1"
                              Color="{DynamicResource Color.Shadow}" />
        </Border.Effect>
        <StackPanel x:Name="Root" />
    </Border>
</Window>
