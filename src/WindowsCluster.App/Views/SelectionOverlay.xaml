<Window x:Class="WindowsCluster.App.Views.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Cluster selection"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="1" Height="1">
    <!-- Rectangle drawn while right-dragging on the desktop. Click-through (WS_EX_TRANSPARENT). -->
    <Border CornerRadius="4"
            BorderThickness="1"
            Background="{DynamicResource Brush.SelectionFill}"
            BorderBrush="{DynamicResource Brush.SelectionBorder}" />
</Window>
